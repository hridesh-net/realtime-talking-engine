    {"id":"docs_engine_implementation_plan_go_live_session_engine","label":"Go Live-session Engine","file_type":"document","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§§1-2,14-15","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Planned persona-agnostic runtime intended to own deterministic media, turn timing, and persistence while delegating only speech and reasoning to models; all 58 implementation tasks are unchecked in the plan."},
    {"id":"docs_engine_implementation_plan_four_plane_architecture","label":"Four-plane Architecture","file_type":"concept","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§2","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Separates media, cognition, session, and persistence so latency-sensitive mechanics remain deterministic and model access stays narrow."},
    {"id":"docs_engine_implementation_plan_session_actor","label":"Per-session Actor","file_type":"concept","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§4","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"One owner goroutine holds all mutable state to avoid mutexes on the latency path and prevent competing writers."},
    {"id":"docs_engine_implementation_plan_state_machine","label":"Conversation State Machine","file_type":"concept","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§4 States","source_url":null,"captured_at":null,"author":null,"contributor":null},

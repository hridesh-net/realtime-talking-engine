    {"id":"docs_engine_implementation_plan_deterministic_pregate","label":"Deterministic Pre-gate","file_type":"concept","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§§4,6,14 task 27","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Incremental lexicon matching on ASR partials should decide DEFER before end-of-turn, avoiding a blocking classifier call."},
    {"id":"docs_engine_implementation_plan_stall_bank","label":"Pre-synthesized Stall Bank","file_type":"concept","source_file":"docs/ENGINE_IMPLEMENTATION_PLAN.md","source_location":"§§1,4,14 task 28","source_url":null,"captured_at":null,"author":null,"contributor":null,"rationale":"Persona-voiced clips hide Thinker latency and must begin within 50 ms; voice seam quality remains an open spike."},

{
  "$defs": {
    "Turn": {
      "description": "One line of the transcript.\n\n``at`` and ``elapsed_ms`` are stamped server-side, never by the client: they\nare the evaluation layer's time base, and a client clock would make two\nsessions incomparable.",
      "properties": {
        "index": {
          "description": "Position in the transcript, from 0.",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "speaker": {
          "pattern": "^(manager|candidate)$",
          "title": "Speaker",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "elapsed_ms": {
          "description": "Milliseconds since the session started.",
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "speaker",
        "text",
        "at",
        "elapsed_ms"
      ],
      "title": "Turn",
      "type": "object"
    }
  },
  "description": "A live or finished interview session with its full server-stamped transcript. Returned by the session endpoints; this is the artifact the evaluation layer reads, and the shape the Go voice engine will emit.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "interview_id": {
      "title": "Interview Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "persona_key": {
      "title": "Persona Key",
      "type": "string"
    },
    "candidate_name": {
      "title": "Candidate Name",
      "type": "string"
    },
    "status": {
      "pattern": "^(live|completed|abandoned)$",
      "title": "Status",
      "type": "string"
    },
    "modality": {
      "default": "text",
      "description": "Voice arrives with the Go engine; the transcript shape does not change.",
      "pattern": "^(text|voice)$",
      "title": "Modality",
      "type": "string"
    },
    "planned_minutes": {
      "title": "Planned Minutes",
      "type": "integer"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "opening_line": {
      "title": "Opening Line",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Turns",
      "type": "array"
    }
  },
  "required": [
    "id",
    "interview_id",
    "candidate_id",
    "persona_key",
    "candidate_name",
    "status",
    "planned_minutes",
    "started_at",
    "opening_line"
  ],
  "title": "SessionResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

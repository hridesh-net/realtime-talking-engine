{
  "$defs": {
    "PrecompiledBelief": {
      "description": "One wrong belief, with the material to sustain it, fixed at design time.\n\n`claim_id` is assigned by code in a stable order so the same persona\ncompiles the same ids every time \u2014 the claims ledger seeds from these at\nturn 0, and a runtime-invented belief would break that determinism.",
      "properties": {
        "claim_id": {
          "pattern": "^b[0-9]+$",
          "title": "Claim Id",
          "type": "string"
        },
        "skill": {
          "title": "Skill",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "elaborations": {
          "items": {
            "type": "string"
          },
          "title": "Elaborations",
          "type": "array"
        },
        "vague_deflections": {
          "items": {
            "type": "string"
          },
          "title": "Vague Deflections",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "skill",
        "statement"
      ],
      "title": "PrecompiledBelief",
      "type": "object"
    },
    "PregateSkill": {
      "description": "How the engine recognises a probe at this skill, from partial speech.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "defer_at_or_below": {
          "maximum": 10,
          "minimum": 0,
          "title": "Defer At Or Below",
          "type": "integer"
        }
      },
      "required": [
        "defer_at_or_below"
      ],
      "title": "PregateSkill",
      "type": "object"
    },
    "UnlockSpec": {
      "description": "`unlock_condition` prose compiled into something the engine can act on.\n\n`never` short-circuits per-turn assessment entirely \u2014 most personas never\nreveal depth, and paying a reasoning call per turn to re-learn that is\nwaste.",
      "properties": {
        "kind": {
          "pattern": "^(never|conditional)$",
          "title": "Kind",
          "type": "string"
        },
        "condition": {
          "default": "",
          "title": "Condition",
          "type": "string"
        },
        "hints": {
          "items": {
            "type": "string"
          },
          "title": "Hints",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "UnlockSpec",
      "type": "object"
    }
  },
  "description": "The runtime slice the Go interview-candidate engine consumes. Served by GET /api/v1/candidates/{candidate_id}/engine-contract.",
  "properties": {
    "contract_version": {
      "default": "v1.6",
      "title": "Contract Version",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "interview_id": {
      "title": "Interview Id",
      "type": "string"
    },
    "system_prompt": {
      "title": "System Prompt",
      "type": "string"
    },
    "opening_line": {
      "title": "Opening Line",
      "type": "string"
    },
    "voice_directives": {
      "additionalProperties": true,
      "title": "Voice Directives",
      "type": "object"
    },
    "turn_policy": {
      "additionalProperties": true,
      "title": "Turn Policy",
      "type": "object"
    },
    "knowledge_ceiling": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Knowledge Ceiling",
      "type": "object"
    },
    "unlock_condition": {
      "title": "Unlock Condition",
      "type": "string"
    },
    "forbidden_behaviors": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Behaviors",
      "type": "array"
    },
    "precompiled_beliefs": {
      "items": {
        "$ref": "#/$defs/PrecompiledBelief"
      },
      "title": "Precompiled Beliefs",
      "type": "array"
    },
    "stall_phrases": {
      "items": {
        "type": "string"
      },
      "title": "Stall Phrases",
      "type": "array"
    },
    "pregate_lexicon": {
      "additionalProperties": {
        "$ref": "#/$defs/PregateSkill"
      },
      "title": "Pregate Lexicon",
      "type": "object"
    },
    "unlock_spec": {
      "$ref": "#/$defs/UnlockSpec"
    },
    "tts_voice_id": {
      "default": "",
      "title": "Tts Voice Id",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "interview_id",
    "system_prompt",
    "opening_line",
    "voice_directives",
    "turn_policy",
    "knowledge_ceiling",
    "unlock_condition",
    "forbidden_behaviors"
  ],
  "title": "EngineContract",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

{
  "$defs": {
    "CandidatePersona": {
      "description": "Seed-derived persona attached to a training-mode interview.",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "background": {
          "title": "Background",
          "type": "string"
        },
        "attributes": {
          "items": {
            "$ref": "#/$defs/PersonaAttribute"
          },
          "title": "Attributes",
          "type": "array"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "name",
        "background",
        "attributes",
        "fingerprint"
      ],
      "title": "CandidatePersona",
      "type": "object"
    },
    "ClarityFact": {
      "description": "One fact about the role the manager is expected to convey.\n\nThe report counts how many were actually said \u2014 the spec's \"4 of 5 role\nfacts conveyed\". A fact with an empty ``statement`` is not on this\ninterview's checklist and is neither counted nor scored against.",
      "properties": {
        "key": {
          "description": "One of: targets, shifts, location, comp_band, growth_path, next_steps.",
          "title": "Key",
          "type": "string"
        },
        "statement": {
          "default": "",
          "description": "The fact in this interview's terms. Empty means 'not applicable here'.",
          "maxLength": 300,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "ClarityFact",
      "type": "object"
    },
    "InterviewConfigInput": {
      "description": "Runtime configuration overrides.",
      "properties": {
        "duration_minutes": {
          "default": 60,
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Duration Minutes",
          "type": "integer"
        },
        "question_mode": {
          "default": "AI",
          "pattern": "^(AI|HYBRID|MANUAL)$",
          "title": "Question Mode",
          "type": "string"
        },
        "interview_mode": {
          "default": "STANDARD",
          "pattern": "^(STANDARD|DEEP)$",
          "title": "Interview Mode",
          "type": "string"
        }
      },
      "title": "InterviewConfigInput",
      "type": "object"
    },
    "PersonaAttribute": {
      "description": "One scored attribute of a training-mode persona.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "title": "Score",
          "type": "integer"
        },
        "variance": {
          "title": "Variance",
          "type": "string"
        }
      },
      "required": [
        "name",
        "score",
        "variance"
      ],
      "title": "PersonaAttribute",
      "type": "object"
    }
  },
  "description": "Interview record returned by the interview endpoints.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "job_title": {
      "title": "Job Title",
      "type": "string"
    },
    "jd": {
      "title": "Jd",
      "type": "string"
    },
    "skills_required": {
      "items": {
        "type": "string"
      },
      "title": "Skills Required",
      "type": "array"
    },
    "job_location_type": {
      "title": "Job Location Type",
      "type": "string"
    },
    "experience_level": {
      "title": "Experience Level",
      "type": "string"
    },
    "company_type": {
      "title": "Company Type",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "location": {
      "default": "",
      "title": "Location",
      "type": "string"
    },
    "department": {
      "default": "",
      "title": "Department",
      "type": "string"
    },
    "manager_level": {
      "default": "",
      "title": "Manager Level",
      "type": "string"
    },
    "language": {
      "default": "english_indian",
      "title": "Language",
      "type": "string"
    },
    "proctoring": {
      "default": "off",
      "title": "Proctoring",
      "type": "string"
    },
    "candidate_notes": {
      "default": "",
      "title": "Candidate Notes",
      "type": "string"
    },
    "clarity_facts": {
      "items": {
        "$ref": "#/$defs/ClarityFact"
      },
      "title": "Clarity Facts",
      "type": "array"
    },
    "report_sections": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Report Sections",
      "type": "object"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/InterviewConfigInput"
    },
    "ai_persona": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidatePersona"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheduled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "start_url": {
      "title": "Start Url",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "id",
    "job_title",
    "jd",
    "skills_required",
    "job_location_type",
    "experience_level",
    "company_type",
    "mode",
    "status",
    "config",
    "created_at",
    "start_url",
    "metadata"
  ],
  "title": "InterviewResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

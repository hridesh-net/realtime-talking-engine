{
  "$defs": {
    "BehavioralAssessment": {
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "focus_areas": {
          "items": {
            "type": "string"
          },
          "title": "Focus Areas",
          "type": "array"
        },
        "sample_questions": {
          "items": {
            "type": "string"
          },
          "title": "Sample Questions",
          "type": "array"
        }
      },
      "required": [
        "required",
        "focus_areas",
        "sample_questions"
      ],
      "title": "BehavioralAssessment",
      "type": "object"
    },
    "EvaluationCriterion": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "weight": {
          "title": "Weight",
          "type": "number"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "name",
        "weight",
        "description"
      ],
      "title": "EvaluationCriterion",
      "type": "object"
    },
    "InterviewPhase": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "duration_minutes": {
          "title": "Duration Minutes",
          "type": "integer"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "guidance": {
          "title": "Guidance",
          "type": "string"
        }
      },
      "required": [
        "name",
        "duration_minutes",
        "mandatory",
        "guidance"
      ],
      "title": "InterviewPhase",
      "type": "object"
    },
    "InterviewerGuidance": {
      "properties": {
        "dos": {
          "items": {
            "type": "string"
          },
          "title": "Dos",
          "type": "array"
        },
        "donts": {
          "items": {
            "type": "string"
          },
          "title": "Donts",
          "type": "array"
        }
      },
      "required": [
        "dos",
        "donts"
      ],
      "title": "InterviewerGuidance",
      "type": "object"
    },
    "ResumeProbing": {
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "focus_areas": {
          "items": {
            "type": "string"
          },
          "title": "Focus Areas",
          "type": "array"
        },
        "sample_questions": {
          "items": {
            "type": "string"
          },
          "title": "Sample Questions",
          "type": "array"
        }
      },
      "required": [
        "required",
        "focus_areas",
        "sample_questions"
      ],
      "title": "ResumeProbing",
      "type": "object"
    },
    "SkillExpectation": {
      "properties": {
        "skill": {
          "title": "Skill",
          "type": "string"
        },
        "priority": {
          "pattern": "^(high|medium|low)$",
          "title": "Priority",
          "type": "string"
        },
        "min_duration_minutes": {
          "title": "Min Duration Minutes",
          "type": "integer"
        },
        "assessment_method": {
          "pattern": "^(live_coding|discussion|scenario|review)$",
          "title": "Assessment Method",
          "type": "string"
        },
        "evidence_to_look_for": {
          "title": "Evidence To Look For",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "priority",
        "min_duration_minutes",
        "assessment_method",
        "evidence_to_look_for"
      ],
      "title": "SkillExpectation",
      "type": "object"
    }
  },
  "description": "Interviewer expectation document for one interview.",
  "properties": {
    "expectation_version": {
      "default": "v1.0",
      "title": "Expectation Version",
      "type": "string"
    },
    "interview_id": {
      "title": "Interview Id",
      "type": "string"
    },
    "interview_type": {
      "pattern": "^(technical_coding|technical_discussion|behavioral|mixed)$",
      "title": "Interview Type",
      "type": "string"
    },
    "structure": {
      "items": {
        "$ref": "#/$defs/InterviewPhase"
      },
      "title": "Structure",
      "type": "array"
    },
    "mandatory_skills": {
      "items": {
        "$ref": "#/$defs/SkillExpectation"
      },
      "title": "Mandatory Skills",
      "type": "array"
    },
    "optional_skills": {
      "items": {
        "$ref": "#/$defs/SkillExpectation"
      },
      "title": "Optional Skills",
      "type": "array"
    },
    "resume_probing": {
      "$ref": "#/$defs/ResumeProbing"
    },
    "behavioral_assessment": {
      "$ref": "#/$defs/BehavioralAssessment"
    },
    "red_flags": {
      "items": {
        "type": "string"
      },
      "title": "Red Flags",
      "type": "array"
    },
    "green_flags": {
      "items": {
        "type": "string"
      },
      "title": "Green Flags",
      "type": "array"
    },
    "evaluation_criteria": {
      "items": {
        "$ref": "#/$defs/EvaluationCriterion"
      },
      "title": "Evaluation Criteria",
      "type": "array"
    },
    "interviewer_guidance": {
      "$ref": "#/$defs/InterviewerGuidance"
    },
    "raw_model_output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Model Output"
    }
  },
  "required": [
    "interview_id",
    "interview_type",
    "structure",
    "mandatory_skills",
    "resume_probing",
    "behavioral_assessment",
    "red_flags",
    "green_flags",
    "evaluation_criteria",
    "interviewer_guidance"
  ],
  "title": "InterviewExpectation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

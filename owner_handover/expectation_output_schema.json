{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterviewExpectation",
  "description": "Response for POST /api/v1/interviews/{id}/expectation and GET /api/v1/interviews/{id}/expectation.",
  "type": "object",
  "required": [
    "expectation_version",
    "interview_id",
    "interview_type",
    "structure",
    "mandatory_skills",
    "resume_probing",
    "behavioral_assessment",
    "red_flags",
    "green_flags",
    "evaluation_criteria",
    "interviewer_guidance"
  ],
  "properties": {
    "expectation_version": {
      "type": "string",
      "const": "v1.0",
      "description": "Schema version for backward compatibility."
    },
    "interview_id": {
      "type": "string",
      "description": "The interview this expectation belongs to."
    },
    "interview_type": {
      "type": "string",
      "enum": ["technical_coding", "technical_discussion", "behavioral", "mixed"],
      "description": "Deterministically selected from experience_level + company_type."
    },
    "structure": {
      "type": "array",
      "description": "Interview phases. duration_minutes must sum to the interview's total duration.",
      "items": {
        "type": "object",
        "required": ["name", "duration_minutes", "mandatory", "guidance"],
        "properties": {
          "name": { "type": "string" },
          "duration_minutes": { "type": "integer" },
          "mandatory": { "type": "boolean" },
          "guidance": { "type": "string" }
        }
      }
    },
    "mandatory_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "priority", "min_duration_minutes", "assessment_method", "evidence_to_look_for"],
        "properties": {
          "skill": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "min_duration_minutes": { "type": "integer" },
          "assessment_method": { "type": "string", "enum": ["live_coding", "discussion", "scenario", "review"] },
          "evidence_to_look_for": { "type": "string" }
        }
      }
    },
    "optional_skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "priority", "min_duration_minutes", "assessment_method", "evidence_to_look_for"],
        "properties": {
          "skill": { "type": "string" },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "min_duration_minutes": { "type": "integer" },
          "assessment_method": { "type": "string", "enum": ["live_coding", "discussion", "scenario", "review"] },
          "evidence_to_look_for": { "type": "string" }
        }
      }
    },
    "resume_probing": {
      "type": "object",
      "required": ["required", "focus_areas", "sample_questions"],
      "properties": {
        "required": { "type": "boolean" },
        "focus_areas": { "type": "array", "items": { "type": "string" } },
        "sample_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "behavioral_assessment": {
      "type": "object",
      "required": ["required", "focus_areas", "sample_questions"],
      "properties": {
        "required": { "type": "boolean" },
        "focus_areas": { "type": "array", "items": { "type": "string" } },
        "sample_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "red_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Baseline red flags from rubric plus role-specific ones added by the model."
    },
    "green_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Baseline green flags from rubric plus role-specific ones added by the model."
    },
    "evaluation_criteria": {
      "type": "array",
      "description": "Exactly the six fixed criteria from the rubric with their exact weights.",
      "items": {
        "type": "object",
        "required": ["name", "weight", "description"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number" },
          "description": { "type": "string" }
        }
      }
    },
    "interviewer_guidance": {
      "type": "object",
      "required": ["dos", "donts"],
      "properties": {
        "dos": { "type": "array", "items": { "type": "string" } },
        "donts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

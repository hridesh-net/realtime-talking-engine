# Expectation agent provider: "gemini" (default) or "openai".
EXPECTATION_PROVIDER=gemini

# Gemini — used when EXPECTATION_PROVIDER=gemini
GEMINI_API_KEY=
# Optional second Gemini key. Tried automatically, on every Gemini call and on
# the voice token mint, when the primary fails for a reason that names the key
# rather than the request — 401/403/429, an invalid or expired key, quota or
# rate limit. Anything else is not retried. Once the fallback works it is
# preferred for the rest of the process. This is a fallback, not a
# configuration: GEMINI_API_KEY2 alone does not make Gemini available.
GEMINI_API_KEY2=
EXPECTATION_MODEL=gemini-3.7-flash

# OpenAI — used when EXPECTATION_PROVIDER=openai
OPENAI_API_KEY=

# Control-plane service
CONTROL_PLANE_DB=control_plane.db
CONTROL_PLANE_PORT=8081

# Where voice-session audio lands when the browser is the recorder. Local
# disk, on this host, never a third party -- deletion is manual (nothing in
# this service prunes it on a schedule).
RECORDINGS_DIR=recordings

# Per-role overrides (fall back to LLM_PROVIDER / LLM_MODEL, then provider default).
# One role per workload so a hot path can move provider without dragging the rest:
#   candidate  — casts a persona from the job spec (structured JSON, one call per persona)
#   session    — plays the persona through a live typed interview (free text, one call per turn)
#   judge      — writes the development report's prose from a finished session:
#                the summary, the per-criterion lines and the strengths and gaps
#                (structured JSON, one call). It authors no numbers — every score
#                is computed by report_engine, and every quote it cites is checked
#                word for word against the transcript before it is printed.
#                Leave blank to produce the report with code-composed sentences.
#   voice      — the live SPOKEN session (realtime speech-to-speech; see below)
CANDIDATE_PROVIDER=
CANDIDATE_MODEL=
SESSION_PROVIDER=
SESSION_MODEL=
JUDGE_PROVIDER=
JUDGE_MODEL=
# Audio analysis. Must resolve to a provider that reads audio natively — today
# that is gemini only; openai has no row in AUDIO_PROVIDERS, and the Analyse
# button is hidden rather than shown broken when none is available.
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=

# Voice mode. This role does NOT fall back to LLM_PROVIDER — it resolves
# against the realtime-capable providers alone, and leaving it blank picks the
# first of those whose key is set, gemini before openai.
#   GET /api/v1/voice-capability reports whether voice is available.
#
#   gemini (default) — Gemini Live over a WebSocket. The browser holds an
#                ephemeral auth token with the whole session config sealed
#                inside it; audio is raw PCM, 16 kHz up and 24 kHz down, and
#                the model transcribes both sides itself. Audio-only sessions
#                are capped around 15 minutes and resume across the cap.
#                Default model: gemini-3.1-flash-live-preview.
#   openai   — the WebRTC path: an SDP offer against a minted client secret.
#                Set VOICE_PROVIDER=openai to keep it. Default model:
#                gpt-realtime-2.
#
# VOICE_MODEL must be a realtime speech model for whichever provider is chosen
# (gemini-3.1-flash-live-preview, gpt-realtime-2, gpt-realtime-2.1-mini), never
# a text model id — pointing one at the other fails at mint time.
VOICE_PROVIDER=
VOICE_MODEL=

# Speech-to-text for the interviewer's own words on the **OpenAI voice path
# only**. Gemini Live transcribes both sides in-session and ignores this.
# Their words are half the evidence the report reads, so the default is the
# larger transcriber rather than the mini one. Default: gpt-4o-transcribe.
TRANSCRIBE_MODEL=
LLM_PROVIDER=
LLM_MODEL=

# ==============================================================================
# Go engine (engine/) — real-time interview runtime.
# Read only by engine/internal/config; see engine/internal/config/config.go
# and engine/internal/config/doc.go. Vars with no default below are required
# and engined refuses to start without them; everything else is optional and
# falls back to the default shown.
# ==============================================================================

# Vendor keys — shared with the control-plane vars above; the engine reads
# the same two names. Required.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
#
# GEMINI_API_KEY2 is deliberately absent here. Bootstrap writes it into
# engined.env alongside control-plane.env for symmetry, but `internal/config`
# reads named variables only, so the engine ignores it: the key failover is a
# Python-side feature (llm/failover.py) and the Go engine has none.

# Model IDs. Required; no default — which vendor/model is live is an
# operational decision, not a code default (see config.go SpeakerModelID doc).
SPEAKER_MODEL_ID=
THINKER_MODEL_ID=
JUDGE_MODEL_ID=
TTS_MODEL_ID=
ASR_MODEL_ID=

# Which vendor backs the Speaker adapter: "gemini" or "openai".
SPEAKER_VENDOR=gemini

# Session bundle storage (recording, transcripts, event log). Bucket/region
# required; the rest optional.
S3_BUCKET=
S3_REGION=
S3_PREFIX=
# S3-compatible store override (e.g. MinIO in local/dev), instead of AWS S3.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Control-plane service the engine fetches contracts from and notifies
# ingest to. Both required.
CONTROL_PLANE_BASE_URL=
CONTROL_PLANE_SHARED_SECRET=

# Per-session spend ceiling in USD; crossing it drives WINDING_DOWN with
# end_reason "cost_cap".
SESSION_COST_CAP_USD=5.0

# Deterministic pre-gate / actor timing knobs, all in milliseconds unless
# noted otherwise.
PREGATE_DEADLINE_MS=250
STALL_DEADLINE_MS=50
THINKER_DEADLINE_MS=700
PAUSE_BEFORE_ANSWER_DEFAULT_MS=700
ABANDON_AFTER_S=300
SESSION_DURATION_CAP_S=3600
CONNECT_TIMEOUT_S=15

# Feature toggles.
WALKBACK_ENABLED=true
DEFER_TOOL_ENABLED=true

# WebRTC transport signaling. WEBRTC_ICE_SERVERS is comma-separated. TURN_*
# are optional; leave blank to offer no TURN relay.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Local disk buffer for in-flight session artifacts before upload to S3.
SPOOL_DIR=./spool

# Metrics HTTP endpoint address; leave blank to disable.
METRICS_ADDR=

# Ordered, append-only roster of prebuilt Gemini TTS voices a persona's
# voice is chosen from (hash of candidate id modulo roster length) — do not
# reorder or remove entries, only append, or existing personas repoint.
GEMINI_TTS_VOICES=Zephyr,Puck,Charon,Kore,Fenrir,Leda,Orus,Aoede,Callirrhoe,Autonoe,Enceladus,Iapetus,Umbriel,Algieba,Despina,Erinome,Algenib,Rasalgethi,Laomedeia,Achernar,Alnilam,Schedar,Gacrux,Pulcherrima,Achird,Zubenelgenubi,Vindemiatrix,Sadachbia,Sadaltager,Sulafat

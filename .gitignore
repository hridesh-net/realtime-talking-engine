# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Secrets — only .env.example is committed
.env
.env.*
!.env.example

# Local SQLite state (regenerated on startup)
*.db

# Session artifacts: in-flight chunks (SPOOL_DIR) and at-rest audio when no
# S3 bucket is configured (OBJECT_STORE_DIR). Regenerated by live sessions.
spool/
objects/
recordings/

# Node / UI
node_modules/
ui/dist/
# owner_handover/ is a generated, local-only deliverable (2026-09-12): it is
# rebuilt from the Pydantic models by scripts/export_schemas.py and is not
# tracked. docs/ stays tracked — the BRD and implementation plans are the
# specification, not a build output.
owner_handover/

.DS_Store
.claude/settings.local.json

# Terraform (infra/terraform) — local plan/apply state, never committed:
# state can contain resource attribute values, and .terraform/ is a
# machine-specific provider cache.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
# Real tfvars carry region/domain/model-id choices and, for the placeholder
# secret variables, whatever a caller passes in — never assume a name is
# safe just because the current file's defaults are placeholders.
# terraform.tfvars.example is the tracked template; keep it exempted.
infra/terraform/*.tfvars
!infra/terraform/terraform.tfvars.example
infra/terraform/crash.log
# .terraform.lock.hcl is intentionally NOT ignored: it pins the exact AWS
# provider version/hash this stack was validated against, and losing that
# to an ignore rule would let `terraform init` silently pick up a newer,
# unvalidated provider on a fresh checkout.

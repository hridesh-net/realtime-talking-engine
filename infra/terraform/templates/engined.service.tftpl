[Unit]
Description=interview-watcher Go engine (engined)
Documentation=https://github.com/hridesh-net/interview-watcher
After=network-online.target
Wants=network-online.target
# The engine writes in-flight session artifacts under SPOOL_DIR before
# upload to S3 — it must not start before that path is actually mounted.
RequiresMountsFor=${data_mount_path}

[Service]
Type=simple
User=${service_user}
Group=${service_user}
EnvironmentFile=${env_file}
WorkingDirectory=${app_dir}
# engined fetches every session's persona from the control plane over
# CONTROL_PLANE_BASE_URL with CONTROL_PLANE_SHARED_SECRET (both in the env
# file) and reports the finished session back the same way. Undeliverable
# reports spool under SPOOL_DIR/ingest and drain on the next start.
ExecStart=${app_dir}/engined -addr=:${engine_port}
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored
# (see root .gitignore) — this example file is the tracked template.

project     = "interview-watcher"
environment = "prod"
aws_region  = "ap-south-1"

# --- DNS / TLS -----------------------------------------------------------
# Required for Caddy to obtain a Let's Encrypt certificate at all. Point
# this at the instance's Elastic IP (see the elastic_ip output) either via
# route53_zone_id below or manually at your DNS provider.
domain_name       = "interview.example.com"
letsencrypt_email = "you@example.com"

# Leave empty to manage DNS manually (the Elastic IP is still output).
route53_zone_id = ""

# --- Compute ---------------------------------------------------------------
instance_type  = "t4g.small"
use_spot       = false
root_volume_gb = 8
data_volume_gb = 20

# The Go engine has no control-plane ContractSource yet and refuses to boot
# without this; see its description in variables.tf before changing it.
engine_dev_sample_contract = true

# --- Model IDs (required by engine/internal/config; no code default) -----
speaker_model_id = "gemini-2.0-flash-live-001"
thinker_model_id = "gemini-3.7-flash"
judge_model_id   = "gemini-3.7-flash"
tts_model_id     = "gemini-2.5-flash-preview-tts"
asr_model_id     = "gemini-2.0-flash-live-001"
speaker_vendor   = "gemini"

# --- Secrets ---------------------------------------------------------------
# These placeholders are written once at `terraform apply` time and then
# ignored (lifecycle.ignore_changes) — Terraform never manages the real
# values. Set the real secrets out-of-band after apply; see infra/README.md.
gemini_api_key_placeholder              = "REPLACE_ME"
openai_api_key_placeholder              = "REPLACE_ME"
control_plane_shared_secret_placeholder = "REPLACE_ME"

# --- Storage ---------------------------------------------------------------
artifact_retention_days = 30
